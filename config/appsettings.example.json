{
  "targets": [
    {
      "id": "my-app",
      "enabled": true,
      "displayName": "My Application",
      "exePath": "C:\\Program Files\\MyApp\\MyApp.exe",
      "processName": "MyApp",
      "detectMode": "processName",
      "checkIntervalSec": 5,
      "restartDelaySec": 30,
      "startGraceSec": 10,
      "ensureRunningOnStart": true,
      "allowMultipleInstances": false,
      "maxRestartsInWindow": 6,
      "restartWindowSec": 600,
      "cooldownSec": 300,
      "stopMethod": "none",
      "manualStopBehavior": "noRestartUntilManualResume"
    },
    {
      "id": "launcher-app",
      "enabled": false,
      "displayName": "Launcher App (processName recommended)",
      "exePath": "C:\\Tools\\FAFinder.exe",
      "args": "/s",
      "processName": "FAFinderMain",
      "detectMode": "processName",
      "checkIntervalSec": 5,
      "restartDelaySec": 30,
      "startGraceSec": 15,
      "ensureRunningOnStart": true,
      "allowMultipleInstances": false,
      "maxRestartsInWindow": 6,
      "restartWindowSec": 600,
      "cooldownSec": 300,
      "stopMethod": "none",
      "manualStopBehavior": "noRestartUntilManualResume",
      "healthCheck": {
        "type": "tcp",
        "host": "localhost",
        "port": 8080,
        "intervalSec": 30,
        "failureCountForHang": 3,
        "restartOnHang": true
      }
    },
    {
      "id": "web-server",
      "enabled": false,
      "displayName": "Web Server with HTTP Health Check",
      "exePath": "C:\\WebServer\\server.exe",
      "processName": "server",
      "detectMode": "processName",
      "checkIntervalSec": 10,
      "restartDelaySec": 15,
      "startGraceSec": 20,
      "ensureRunningOnStart": true,
      "allowMultipleInstances": false,
      "maxRestartsInWindow": 4,
      "restartWindowSec": 600,
      "cooldownSec": 600,
      "stopMethod": "closeWindow",
      "manualStopBehavior": "noRestartUntilManualResume",
      "healthCheck": {
        "type": "http",
        "url": "http://localhost:8080/health",
        "intervalSec": 30,
        "failureCountForHang": 3,
        "restartOnHang": true
      }
    }
  ],
  "logDir": "logs",
  "stateDir": "state",
  "logRetainDays": 30,
  "manualStopHeuristic": false,
  "manualStopHeuristicWindowSec": 10
}
